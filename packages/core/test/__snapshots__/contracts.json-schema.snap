  "findings.FactValueSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "anyOf": [
      {
        "maxLength": 1000,
        "type": "string"
      },
      {
        "type": "number"
      },
      {
        "type": "boolean"
      },
      {
        "type": "null"
      }
    ]
  },
  "findings.FindingDetailSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "expected": {
        "maxLength": 300,
        "type": "string"
      },
      "explanation": {
        "maxLength": 1000,
        "minLength": 1,
        "type": "string"
      },
      "facts": {
        "additionalProperties": {
          "anyOf": [
