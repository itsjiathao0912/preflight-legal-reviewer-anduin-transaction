{
  "ai.AiCandidateSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "id": {
        "maxLength": 64,
        "minLength": 1,
        "type": "string"
      },
      "issue_class_hint": {
        "enum": [
          "broken_cross_reference",
          "broken_conditional",
          "unreachable_or_circular_flow",
          "option_gap_overlap",
          "defined_term_issue",
          "inconsistent_footnote_requirement",
          "logic_contradiction",
          "ambiguity",
          "meaningful_typo",
          "version_drift",
          "drafting_note",
          "placeholder",
          "sensitive_data",
          "investor_path_dead_end",
          "investor_path_missing_item"
        ],
        "type": "string"
      },
      "quote": {
        "maxLength": 1000,
        "minLength": 1,
        "type": "string"
      },
      "section_path": {
        "items": {
          "maxLength": 300,
          "type": "string"
        },
        "maxItems": 8,
        "type": "array"
      }
    },
    "required": [
      "id",
      "quote",
      "section_path"
    ],
    "type": "object"
  },
  "ai.AiFindingSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "candidate_id": {
        "maxLength": 64,
        "minLength": 1,
        "type": "string"
      },
      "confidence": {
        "maximum": 1,
        "minimum": 0,
        "type": "number"
      },
      "explanation": {
        "maxLength": 1000,
        "minLength": 1,
        "type": "string"
      },
      "interpretations": {
        "items": {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        },
        "maxItems": 6,
        "type": "array"
      },
      "issue_class": {
        "enum": [
          "broken_cross_reference",
          "broken_conditional",
          "unreachable_or_circular_flow",
          "option_gap_overlap",
          "defined_term_issue",
          "inconsistent_footnote_requirement",
          "logic_contradiction",
          "ambiguity",
          "meaningful_typo",
          "version_drift",
          "drafting_note",
          "placeholder",
          "sensitive_data",
          "investor_path_dead_end",
          "investor_path_missing_item"
        ],
        "type": "string"
      },
      "quote": {
        "maxLength": 1000,
        "minLength": 1,
        "type": "string"
      },
      "severity": {
        "enum": [
          "high",
          "medium",
          "low"
        ],
        "type": "string"
      }
    },
    "required": [
      "candidate_id",
      "issue_class",
      "severity",
      "confidence",
      "quote",
      "explanation"
    ],
    "type": "object"
  },
  "ai.AiRequestSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "candidates": {
        "items": {
          "properties": {
            "id": {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            "issue_class_hint": {
              "enum": [
                "broken_cross_reference",
                "broken_conditional",
                "unreachable_or_circular_flow",
                "option_gap_overlap",
                "defined_term_issue",
                "inconsistent_footnote_requirement",
                "logic_contradiction",
                "ambiguity",
                "meaningful_typo",
                "version_drift",
                "drafting_note",
                "placeholder",
                "sensitive_data",
                "investor_path_dead_end",
                "investor_path_missing_item"
              ],
              "type": "string"
            },
            "quote": {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            "section_path": {
              "items": {
                "maxLength": 300,
                "type": "string"
              },
              "maxItems": 8,
              "type": "array"
            }
          },
          "required": [
            "id",
            "quote",
            "section_path"
          ],
          "type": "object"
        },
        "maxItems": 40,
        "minItems": 1,
        "type": "array"
      },
      "ext": {
        "additionalProperties": {},
        "propertyNames": {
          "type": "string"
        },
        "type": "object"
      },
      "law_firm_id": {
        "anyOf": [
          {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "settings": {
        "properties": {
          "model_tier": {
            "maxLength": 40,
            "type": "string"
          }
        },
        "type": "object"
      },
      "task": {
        "default": "clause-judgment",
        "enum": [
          "clause-judgment",
          "counsel-draft"
        ],
        "type": "string"
      },
      "v": {
        "const": 1,
        "type": "number"
      }
    },
    "required": [
      "v",
      "law_firm_id",
      "candidates",
      "settings"
    ],
    "type": "object"
  },
  "ai.AiResultSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "drafts": {
        "items": {
          "properties": {
            "candidate_id": {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            "text": {
              "maxLength": 1500,
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "candidate_id",
            "text"
          ],
          "type": "object"
        },
        "maxItems": 40,
        "type": "array"
      },
      "ext": {
        "additionalProperties": {},
        "propertyNames": {
          "type": "string"
        },
        "type": "object"
      },
      "findings": {
        "items": {
          "properties": {
            "candidate_id": {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            "confidence": {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            "explanation": {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            "interpretations": {
              "items": {
                "maxLength": 500,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 6,
              "type": "array"
            },
            "issue_class": {
              "enum": [
                "broken_cross_reference",
                "broken_conditional",
                "unreachable_or_circular_flow",
                "option_gap_overlap",
                "defined_term_issue",
                "inconsistent_footnote_requirement",
                "logic_contradiction",
                "ambiguity",
                "meaningful_typo",
                "version_drift",
                "drafting_note",
                "placeholder",
                "sensitive_data",
                "investor_path_dead_end",
                "investor_path_missing_item"
              ],
              "type": "string"
            },
            "quote": {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            "severity": {
              "enum": [
                "high",
                "medium",
                "low"
              ],
              "type": "string"
            }
          },
          "required": [
            "candidate_id",
            "issue_class",
            "severity",
            "confidence",
            "quote",
            "explanation"
          ],
          "type": "object"
        },
        "type": "array"
      },
      "usage": {
        "properties": {
          "tokens_in": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          },
          "tokens_out": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          }
        },
        "type": "object"
      },
      "v": {
        "const": 1,
        "type": "number"
      }
    },
    "required": [
      "v",
      "findings"
    ],
    "type": "object"
  },
  "cacheKey.CacheKeyInputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "input_hash": {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
      },
      "kind": {
        "enum": [
          "ai",
          "ocr"
        ],
        "type": "string"
      },
      "model": {
        "maxLength": 120,
        "minLength": 1,
        "type": "string"
      },
      "prompt_ver": {
        "maxLength": 40,
        "minLength": 1,
        "type": "string"
      },
      "rules_hash": {
        "maxLength": 64,
        "minLength": 1,
        "type": "string"
      },
      "schema_ver": {
        "maxLength": 40,
        "minLength": 1,
        "type": "string"
      }
    },
    "required": [
      "kind",
      "input_hash",
      "model",
      "prompt_ver",
      "schema_ver",
      "rules_hash"
    ],
    "type": "object"
  },
  "claims.CreateSessionRequestSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "analyst_name": {
        "maxLength": 80,
        "minLength": 1,
        "type": "string"
      },
      "turnstile": {
        "maxLength": 2048,
        "minLength": 1,
        "type": "string"
      }
    },
    "required": [
      "analyst_name"
    ],
    "type": "object"
  },
  "claims.CreateSessionResponseSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "analyst_id": {
        "maxLength": 64,
        "minLength": 1,
        "type": "string"
      },
      "expires_at": {
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991,
        "type": "integer"
      },
      "kind": {
        "enum": [
          "sandbox",
          "visitor"
        ],
        "type": "string"
      },
      "read_only": {
        "type": "boolean"
      },
      "workspace_id": {
        "maxLength": 64,
        "minLength": 1,
        "type": "string"
      }
    },
    "required": [
      "workspace_id",
      "analyst_id",
      "kind",
      "expires_at",
      "read_only"
    ],
    "type": "object"
  },
  "claims.SessionClaimsSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "a": {
        "maxLength": 64,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9_-]+$",
        "type": "string"
      },
      "exp": {
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991,
        "type": "integer"
      },
      "iat": {
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
      },
      "kid": {
        "maxLength": 64,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9_-]+$",
        "type": "string"
      },
      "t": {
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
      },
      "v": {
        "maxLength": 64,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9_-]+$",
        "type": "string"
      },
      "w": {
        "maxLength": 64,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9_-]+$",
        "type": "string"
      }
    },
    "required": [
      "v",
      "iat",
      "exp",
      "kid"
    ],
    "type": "object"
  },
  "errors.ErrorBodySchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "error": {
        "properties": {
          "code": {
            "enum": [
              "fingerprint_mismatch",
              "read_only_demo",
              "rate_limited",
              "quota_exhausted",
              "budget_cap",
              "upstream_failed",
              "memory_unavailable",
              "payload_too_large",
              "unsupported_type",
              "invalid_session",
              "conflict_active_decision",
              "invalid_request"
            ],
            "type": "string"
          },
          "message": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "reason": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "retry_after_s": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "type": "object"
      }
    },
    "required": [
      "error"
    ],
    "type": "object"
  },
