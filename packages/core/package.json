    "test:vectors": "vitest run test/vectors",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "diff": "9.0.0",
    "htmlparser2": "12.0.0",
    "mammoth": "1.13.0",
    "unpdf": "1.9.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "fast-check": "4.10.2",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  }
}
