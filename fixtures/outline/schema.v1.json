{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "form-logic-outline/v1"
    },
    "disclaimer": {
      "type": "string",
      "const": "Reference outline only; not a generated form."
    },
    "document": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "format": {
          "type": "string",
          "enum": ["html", "pdf", "docx", "ocr"]
        },
        "contentHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "pageCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": ["name", "format", "contentHash"],
      "additionalProperties": false
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "number": {
            "type": "string",
            "maxLength": 300
          },
          "title": {
            "type": "string",
            "maxLength": 300
          },
          "depth": {
            "anyOf": [
              {
                "type": "number",
                "const": 0
              },
              {
                "type": "number",
                "const": 1
              }
            ]
          },
          "restart": {
            "type": "boolean"
          },
          "refsIn": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "refsOut": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": ["id", "number", "title", "depth", "restart", "refsIn", "refsOut"],
        "additionalProperties": false
      }
    },
    "references": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "text": {
                "type": "string",
                "maxLength": 300
              },
              "where": {
                "type": "string",
                "maxLength": 300
              },
              "status": {
                "type": "string",
                "enum": ["resolved", "suspicious", "unresolved"]
              },
              "target": {
                "type": "string",
                "maxLength": 300
              },
              "expected": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 300
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "external": {
                "type": "boolean",
                "const": false
              }
            },
            "required": ["id", "text", "where", "status"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "text": {
                "type": "string",
                "maxLength": 300
              },
              "where": {
                "type": "string",
                "maxLength": 300
              },
              "source": {
                "type": "string",
                "maxLength": 300
              },
              "external": {
                "type": "boolean",
                "const": true
              }
            },
            "required": ["id", "text", "where", "source", "external"],
            "additionalProperties": false
          }
        ]
      }
    },
    "branches": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "kind": {
            "type": "string",
            "enum": ["whitelist", "role", "skip", "negative", "jump"]
          },
          "where": {
            "type": "string",
            "maxLength": 300
          },
          "condition": {
            "type": "string",
            "maxLength": 300
          },
          "targets": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 300
            }
          },
          "targetFound": {
            "type": "boolean"
          },
          "citation": {
            "type": "string",
            "maxLength": 300
          }
        },
        "required": ["id", "kind", "where", "condition", "targets", "targetFound", "citation"],
        "additionalProperties": false
      }
    },
    "definedTerms": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "term": {
            "type": "string",
            "maxLength": 300
          },
          "definedAt": {
            "type": "string",
            "maxLength": 300
          },
          "uses": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "status": {
            "type": "string",
            "enum": ["ok", "early", "twice", "none", "unused", "case"]
          },
          "note": {
            "type": "string",
            "maxLength": 300
          }
        },
        "required": ["term", "definedAt", "uses", "status"],
        "additionalProperties": false
      }
    },
    "investorPaths": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "maxLength": 300
          },
          "label": {
            "type": "string",
            "maxLength": 300
          },
          "sections": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "number": {
                  "type": "string",
                  "maxLength": 300
                },
                "title": {
                  "type": "string",
                  "maxLength": 300
                }
              },
              "required": ["number", "title"],
              "additionalProperties": false
            }
          },
          "skipped": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "number": {
                  "type": "string",
                  "maxLength": 300
                },
                "title": {
                  "type": "string",
                  "maxLength": 300
                }
              },
              "required": ["number", "title"],
              "additionalProperties": false
            }
          },
          "questions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "section": {
                  "type": "string",
                  "maxLength": 300
                },
                "text": {
                  "type": "string",
                  "maxLength": 300
                }
              },
              "required": ["section", "text"],
              "additionalProperties": false
            }
          },
          "reachesCompletion": {
            "type": "boolean"
          },
          "uncertain": {
            "type": "boolean"
          },
          "gapCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "type",
          "label",
          "sections",
          "skipped",
          "questions",
          "reachesCompletion",
          "uncertain",
          "gapCount"
        ],
        "additionalProperties": false,
        "description": "Investor-type path. Heuristic: derived from routing cues in the document, with no ground truth; check it against the form."
      },
      "description": "Investor-type paths are heuristic (no ground truth); reference only."
    },
    "confidenceNote": {
      "type": "string",
      "maxLength": 300
    },
    "counts": {
      "type": "object",
      "properties": {
        "sections": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "references": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "branches": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "definedTerms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "investorPaths": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": ["sections", "references", "branches", "definedTerms", "investorPaths"],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "disclaimer",
    "document",
    "sections",
    "references",
    "branches",
    "definedTerms",
    "investorPaths",
    "counts"
  ],
  "additionalProperties": false,
  "description": "Reference outline only; not a generated form. Form logic outline exported from the structure view."
}
