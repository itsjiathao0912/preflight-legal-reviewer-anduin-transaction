        {
          "detector_id": "defined-term-issues",
          "issue_class": "defined_term_issue",
          "count": 1
        }
      ]
    },
    {
      "file": "unused.html",
      "kind": "defect",
      "note": "\"Escrow Agent\" is defined and never used",
      "expect": [
        {
          "detector_id": "defined-term-issues",
          "issue_class": "defined_term_issue",
          "count": 1
        }
      ]
    },
    {
      "file": "capitalization.html",
      "kind": "defect",
      "note": "\"Investor Questionnaire\" also written \"Investor questionnaire\"",
      "expect": [
        {
          "detector_id": "defined-term-issues",
          "issue_class": "defined_term_issue",
          "count": 1
        }
      ]
