// Sub-doc QA Worker: serves the built SPA as static assets and /api/* from the Worker.
// Rules (guard:cf enforces): no routes, no custom domains, no zone references; every
// resource name starts with "aduin-transaction" (sole exception: the Worker name
// "preflight-legal-reviewer", user-approved 19-10-26). Deploys go to *.workers.dev only.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "preflight-legal-reviewer",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aduin-transaction-db",
      "database_id": "5f0d76d8-ad88-4a0b-80eb-cff716c10eca",
    },
  ],
  // Phase 04b: daily retention purge (the lazy purge from new sessions stays the baseline).
  "triggers": { "crons": ["17 3 * * *"] },
  "vars": {
    "PAID_FALLBACK_ENABLED": "false",
    "OPENROUTER_BASE_URL": "https://openrouter.ai/api/v1",
    "AI_TEXT_MODELS": "nvidia/nemotron-3-super-120b-a12b:free",
    "AI_RESPONSE_MODE": "json_schema",
    "AI_VISION_MODELS": "nvidia/nemotron-3.5-super-vl:free",
    "AI_UPLOADS_ENABLED": "true",
  },
}
