{
  "name": "@aduin/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "tsx ../../scripts/src/build-samples.ts",
    "dev": "vite",
    "prebuild": "tsx ../../scripts/src/build-samples.ts",
    "build": "vite build",
    "prebuild:e2e": "tsx ../../scripts/src/build-samples.ts",
    "build:e2e": "vite build --mode e2e",
    "preview": "vite preview",
    "test": "vitest run",
    "pretest:e2e": "tsx ../../scripts/src/build-samples.ts",
    "test:e2e": "playwright test --project=preview",
    "pretest:a11y": "tsx ../../scripts/src/build-samples.ts",
    "test:a11y": "playwright test --project=preview a11y-smoke",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@aduin/core": "workspace:*",
    "@fontsource/geist": "5.3.0",
    "@fontsource/newsreader": "5.3.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-slot": "1.5.0",
    "@tanstack/react-table": "9.3.1",
    "comlink": "4.4.2",
    "dexie": "4.4.6",
    "docx": "9.11.0",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "fake-indexeddb": "6.2.5",
    "jsdom": "30.1.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "4.1.12"
  }
}
